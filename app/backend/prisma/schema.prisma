generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Scents {
  id    Int      @id @default(autoincrement())
  Name  String   @unique
  Notes String[]
}

model Note {
  id          Int    @id @default(autoincrement())
  name        String @unique
  description String
  userNotes UserNote[]
}

// profile table
model Profile {
  id          Int           @id @default(autoincrement())
  clerkId     String        @unique
  displayName String
  bio         String
  userProfile UserProfile[]
}

// location table
model Location {
  id            Int            @id @default(autoincrement())
  fragranceId   Int            @unique
  saleLocations SaleLocation[]
}

// salelocation table
model SaleLocation {
  id         Int      @id @default(autoincrement())
  name       String
  locationId Int
  location   Location @relation(fields: [locationId], references: [id])
}

model User {
  id          String        @id
  userProfile UserProfile[]
  userNotes   UserNote[]
}

model UserProfile {
  user        User    @relation(fields: [userId], references: [id])
  profile     Profile @relation(fields: [profileId], references: [id])
  userId      String
  profileId   Int

  @@id([userId, profileId])
}

model UserTag {
  id      Int    @id @default(autoincrement())
  clerkId String
  tag     String

  @@unique([clerkId, tag])
}

model UserNote {
  user      User @relation(fields: [userId], references: [id])
  note      Note @relation(fields: [noteId], references: [id])
  userId    String
  noteId    Int

  @@id([userId, noteId])
}